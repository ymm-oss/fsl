fsl 5
// expected-command: refine leave_request.en.fsl leave_flow_tobe.en.fsl leave_request_refines_tobe.fsl --depth 8
// expected-result: refines
// The requirements layer refines the To-Be business flow: each requirements
// event is the business transition of the same name, and arranging a
// substitute changes no business stage. The two layers declare the same stage
// enum (the requirements orders it by its lifecycle lines), so the stage maps
// one to one. The history flags of the two business no-bypass policies are
// read off the stage: a leave has passed through Approved exactly when it is
// Approved, Taken or Cancelled, and through Submitted when it is past Draft.
// The two business policies are not pulled through this mapping: `preserve
// progress { respond <name> by … }` reads an identifier, and a policy ID such
// as POL-LEAVEFLOW-002 is not one. The requirements layer states the same two
// policies itself (POL-LEAVE-001, POL-LEAVE-002) and verifies them.
refinement LeaveRequestsRefineToBe {
  impl LeaveRequests
  abs LeaveFlowToBe

  map leave_stage[c: Leave] = leave_stage[c]
  map leave_stage_via_Approved[c: Leave] =
  leave_stage[c] == Approved or leave_stage[c] == Taken or leave_stage[c] == Cancelled
  map leave_stage_via_Submitted[c: Leave] = leave_stage[c] != Draft

  action submit(l, days) -> submit(l)
  action auto_approve(l) -> auto_approve(l)
  action approve(l) -> approve(l)
  action reject(l) -> reject(l)
  action arrange(l) -> stutter
  action take(l) -> take(l)
  action cancel(l) -> cancel(l)
}
