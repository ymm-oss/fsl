fsl 5
// 休暇申請を FSL 5 の日本語の綴り(キーワードと助詞)で書いた例。
// leave_request.en.fsl と同じモデル。用語集が英語の正規名に日本語の別名を付ける。
要件 LeaveRequests {
  用語集 {
    Days = 日数
    AUTO_LIMIT = 自動承認上限
    MAX_DAYS = 最大日数
    Employee = 従業員
    Manager = 上長
    System = システム
    Leave = 休暇
    Leave.days = 休暇日数
    Leave.substitute = 代行手配済み
    Draft = 下書き
    Submitted = 申請済み
    Approved = 承認済み
    Rejected = 却下済み
    Taken = 取得済み
    Cancelled = 取消済み
    ShortLeave = 短期休暇
    LongLeave = 長期休暇
    submits = 申請する
    approves = 承認する
    rejects = 却下する
    staffs = 代行手配する
    takes = 取得する
    cancels = 取り消す
  }

  数値 日数
  定数 自動承認上限 = 1
  定数 最大日数 = 3
  アクター 従業員, 上長, システム

  エンティティ 休暇 {
    休暇日数: 日数 = 0
    代行手配済み: Bool = false
    ライフサイクル 下書き -> 申請済み -> 承認済み -> 取得済み
    ライフサイクル 申請済み -> 却下済み
    ライフサイクル 承認済み -> 取消済み
  }

  区分 短期休暇 = 休暇 のうち 休暇日数 <= 自動承認上限
  区分 長期休暇 = 休暇 のうち 休暇日数 > 自動承認上限

  出来事 submit = 従業員 が 休暇 を 申請する 休暇日数 で 下書き -> 申請済み
  出来事 auto_approve = システム が 休暇 を 承認する 申請済み -> 承認済み
  出来事 approve = 上長 が 休暇 を 承認する 申請済み -> 承認済み
  出来事 reject = 上長 が 休暇 を 却下する 申請済み -> 却下済み
  出来事 arrange = 上長 が 休暇 を 代行手配する 段階 承認済み
    更新 代行手配済み = true
  出来事 take = 従業員 が 休暇 を 取得する 承認済み -> 取得済み
  出来事 cancel = 従業員 が 休暇 を 取り消す 承認済み -> 取消済み

  規則 REQ-LEAVE-001 "休暇は 1 日以上 最大日数 以下で申請する" {
    許可 従業員 が 休暇 を 申請する 条件 入力 休暇日数 > 0 かつ 入力 休暇日数 <= 最大日数
  }

  決定表 REQ-LEAVE-002 "申請された休暇を誰が決めるか" 対象 申請済み 休暇 {
    短期休暇 => システム が 承認する
      対応要件 REQ-LEAVE-003 "自動承認上限 以下の休暇はシステムが承認する"
    長期休暇 => 上長 が 承認する または 却下する
      対応要件 REQ-LEAVE-004 "それより長い休暇は上長が承認または却下する"
  }

  規則 REQ-LEAVE-005 "代行の手配前に休暇は取得しない" {
    禁止 従業員 が 休暇 を 取得する 条件 not 代行手配済み
    TakenHasSubstitute: 常に 休暇 段階 取得済み 必須 代行手配済み
  }

  規則 REQ-LEAVE-006 "申請後の休暇は有効な日数を保つ" {
    DaysInRange: 常に 休暇 段階以外 下書き 必須 休暇日数 > 0 かつ 休暇日数 <= 最大日数
  }

  規則 REQ-LEAVE-007 "代行は承認された休暇にだけ手配する" {
    NoEarlySubstitute: 常に 休暇 段階 下書き, 申請済み, 却下済み 必須 not 代行手配済み
  }

  // ライフサイクルから既に従う(check は implied_by_lifecycle を severity info で報告する)。
  // 明示すると、各遷移が検査される性質になる。
  規則 REQ-LEAVE-008 "休暇は申請中にだけ承認し、承認後にだけ取得する" {
    ApprovedFromSubmitted: 休暇 遷移先 承認済み 遷移元 申請済み
    TakenFromApproved: 休暇 遷移先 取得済み 遷移元 承認済み
  }

  規則 REQ-LEAVE-009 "却下するのは 自動承認上限 を超える休暇だけ" {
    RejectedIsLong: 常に 休暇 段階 却下済み 必須 休暇日数 > 自動承認上限
  }

  目標 GOAL-LEAVE-001 "休暇は取得まで進める" いずれかの 休暇 到達可能 取得済み
  方針 POL-LEAVE-001 "申請された休暇はいずれ決まる"
    すべての 休暇 段階 申請済み いずれ必ず 承認済み または 却下済み
  方針 POL-LEAVE-002 "承認された休暇はいずれ取得か取消になる"
    すべての 休暇 段階 承認済み いずれ必ず 取得済み または 取消済み

  シナリオ AC-LEAVE-001 "1 日の休暇はシステムが承認し取得される" {
    従業員 が l1 を 休暇日数 1 で 申請する
    システム が l1 を 承認する
    上長 が l1 を 代行手配する
    従業員 が l1 を 取得する
    結果 l1 は 取得済み
  }

  シナリオ AC-LEAVE-002 "3 日の休暇を上長が却下し、1 日の休暇はシステムが承認する" {
    従業員 が l1 を 休暇日数 3 で 申請する
    従業員 が l2 を 休暇日数 1 で 申請する
    システム が l2 を 承認する
    上長 が l1 を 却下する
    結果 l1 は 却下済み
  }

  シナリオ AC-LEAVE-003 "承認された休暇は取り消せる" {
    従業員 が l1 を 休暇日数 2 で 申請する
    上長 が l1 を 承認する
    従業員 が l1 を 取り消す
    結果 l1 は 取消済み
  }

  拒否シナリオ FB-LEAVE-001 "0 日の休暇は申請できない" {
    従業員 が l1 を 休暇日数 0 で 申請する
    結果 拒否
  }

  拒否シナリオ FB-LEAVE-002 "最大日数 を超える休暇は申請できない" {
    従業員 が l1 を 休暇日数 4 で 申請する
    結果 拒否
  }

  拒否シナリオ FB-LEAVE-003 "1 日の休暇は上長が決めない" {
    従業員 が l1 を 休暇日数 1 で 申請する
    上長 が l1 を 承認する
    結果 拒否
  }

  拒否シナリオ FB-LEAVE-004 "代行の手配前に休暇は取得できない" {
    従業員 が l1 を 休暇日数 1 で 申請する
    システム が l1 を 承認する
    従業員 が l1 を 取得する
    結果 拒否
  }

  拒否シナリオ FB-LEAVE-005 "3 日の休暇をシステムは承認しない" {
    従業員 が l1 を 休暇日数 3 で 申請する
    システム が l1 を 承認する
    結果 拒否
  }
}

検証 {
  個数 休暇 = 2
  値域 日数 = 0..4
}
