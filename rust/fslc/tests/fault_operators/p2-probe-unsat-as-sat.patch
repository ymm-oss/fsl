P2 SAT/UNSAT substitution: classify an unsatisfiable violation probe as
satisfiable. A known-safe type-bound probe becomes a false violation before
the real invariant witness, cutting model↔oracle identity.

--- a/rust/fsl-verifier/src/bmc.rs
+++ b/rust/fsl-verifier/src/bmc.rs
@@ -2795,7 +2795,7 @@ async fn probe_not<S: SmtSolver>(solver: &mut S, condition: &S::Term) -> Result<
 async fn probe<S: SmtSolver>(solver: &mut S, condition: &S::Term) -> Result<bool, VerifyError> {
     match scoped_check(solver, [condition], PopFailure::OverAssert).await? {
         SatResult::Sat => Ok(true),
-        SatResult::Unsat => Ok(false),
+        SatResult::Unsat => Ok(true),
         SatResult::Unknown => Err(VerifyError::solver("solver returned unknown")),
     }
 }
