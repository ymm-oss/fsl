// `sweep_violating.fsl` with Amount = 0..2: deposit(2) is the only
// one-step violation, so every engine must report the same shortest trace
// (#1940: the bounded search's choice among several is the solver's).
spec UniqueShortestViolation {
  type Amount = 0..2
  state { balance: Int }
  init { balance = 0 }
  action deposit(a: Amount) {
    requires a > 0
    balance = balance + a
  }
  invariant TooSmall { balance <= 1 }
}
