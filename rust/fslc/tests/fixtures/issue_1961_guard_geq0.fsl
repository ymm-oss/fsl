// SPDX-License-Identifier: Apache-2.0
// Issue #1961 (#1962 re-review): BMC reads `q.head()` on an empty `q` as an
// unconstrained integer, not a value of `Job`, so `q.head() >= 0` can be
// false: at `--depth 1` every engine reports `_partial_property_terminal`.
spec G_geq0 {
  type Job = 0..1
  type Z = 0..1
  state { done: Bool, z: Z, q: Seq<Job, 2> }
  init { done = false z = 0 q = Seq { } }
  action a() { requires not done done = true  }
  action g() { requires done and q.head() >= 0 z = 0 }
  terminal { q.head() == 1 }
}
