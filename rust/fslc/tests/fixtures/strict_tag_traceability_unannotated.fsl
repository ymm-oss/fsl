requirements StrictTagTraceabilityUnannotated {
  process Trace {
    stages Open, Closed
    initial Open
    transition close Open -> Closed by User
  }

  state { ready: Bool, n: 0..3 }

  init {
    ready = false
    n = 0
  }

  invariant ReadyBounded {
    ready == ready and n <= 3
  }

  action bump() {
    requires n < 3
    n = n + 1
  }

  trans Monotone {
    n >= old(n)
  }

  requirement REQ-BLOCK "block requirement" {
    action mark_ready() {
      ready = true
    }
  }

  acceptance AC-TRACE-001 "close one trace item" {
    close(0)
    expect Trace 0 in Closed
  }

  forbidden FB-TRACE-001 "cannot close twice" {
    close(0)
    close(0)
    expect rejected
  }
}

verify {
  instances Trace = 1
}
