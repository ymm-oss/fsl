// SPDX-License-Identifier: Apache-2.0
// Issue #1961 (#1962 review): at step 1 the `c` state (`k = 3`, empty `q`)
// enables no action, and `g`'s guard reaches `q.head()` on the empty `q`.
// BMC reads that partial read as an unconstrained value, so its deadlock
// query treats the state as dead. At `--depth 1`, where no action of step 1
// is checked, every engine reports `partial_op` `_partial_property_terminal`
// at step 1; at `--depth 2` the guard's own `_partial_g` at step 2 comes first.
spec GuardPartial {
  type Job = 0..1
  type K = 0..3
  state { done: Bool, k: K, q: Seq<Job, 2> }
  init { done = false k = 0 q = Seq { } }
  action a() { requires not done k = 1 done = true q = q.push(0) }
  action b() { requires not done k = 2 done = true q = q.push(0) }
  action c() { requires not done k = 3 done = true }
  action g() { requires done and k == 3 and q.head() == 0 k = 3 }
  terminal { q.head() == 1 }
}
