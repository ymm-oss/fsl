fsl 5
// e2e/glossary_ja.fsl with ASCII aliases (romanised Japanese): the
// resolution of aliases does not depend on the wider identifier rule.
// Lowers to exactly the kernel of fsl5/e2e/fsl5_en_norules.fsl.
requirements ExpenseRequirements {
  glossary {
    ExpenseRequirements = KeihiSeisanYoken
    Amount       = Kingaku
    AUTO_LIMIT   = JidoShoninJogen
    Employee     = Jugyoin
    System       = Shisutemu
    Manager      = Jocho
    Finance      = Keiri
    Claim        = Shinsei
    Claim.amount = ShinseiKingaku
    Draft        = Shitagaki
    Submitted    = TeishutsuZumi
    Approved     = ShoninZumi
    Rejected     = KyakkaZumi
    Paid         = ShiharaiZumi
    SmallClaim   = ShogakuShinsei
    LargeClaim   = KogakuShinsei
    submits      = Teishutsusuru
    approves     = Shoninsuru
    rejects      = Kyakkasuru
    pays         = Shiharau
    submit       = Teishutsu
    auto_approve = JidoShonin
    mgr_approve  = JochoShonin
    reject       = Kyakka
    pay          = Shiharai
    paid_claims  = ShiharaiKensu
  }

  implements ExpenseToBe from "../../fsl5/e2e/1_business.fsl" {
    action submit(c, amount) -> submit(c)
  }

  number Kingaku
  const JidoShoninJogen = 1
  actor Jugyoin, Shisutemu, Jocho, Keiri

  entity Shinsei {
    ShinseiKingaku: Kingaku = 0
    lifecycle Shitagaki -> TeishutsuZumi -> ShoninZumi
    lifecycle TeishutsuZumi -> KyakkaZumi
    lifecycle ShoninZumi -> ShiharaiZumi
  }

  concept ShogakuShinsei = Shinsei where ShinseiKingaku <= JidoShoninJogen
  concept KogakuShinsei = Shinsei where ShinseiKingaku > JidoShoninJogen

  event Teishutsu     = Jugyoin Teishutsusuru Shinsei with ShinseiKingaku   Shitagaki -> TeishutsuZumi
  event JidoShonin = Shisutemu Shoninsuru Shinsei               TeishutsuZumi -> ShoninZumi
  event JochoShonin = Jocho Shoninsuru Shinsei                   TeishutsuZumi -> ShoninZumi
  event Kyakka     = Jocho Kyakkasuru Shinsei                   TeishutsuZumi -> KyakkaZumi
  event Shiharai     = Keiri Shiharau Shinsei                     ShoninZumi -> ShiharaiZumi
    covers REQ-4 "承認された申請だけが支払われる"

  kpi ShiharaiKensu = count Shinsei in ShiharaiZumi

  scenario AC-1 "承認の流れ: 少額の申請が自動承認され支払われる" {
    Jugyoin Teishutsusuru Shinsei1 with ShinseiKingaku 1
    Shisutemu Shoninsuru Shinsei1
    Keiri Shiharau Shinsei1
    then Shinsei1 is ShiharaiZumi
  }
  scenario AC-2 "却下の流れ: 高額の申請が上長に却下される" {
    Jugyoin Teishutsusuru Shinsei1 with ShinseiKingaku 2
    Jocho Kyakkasuru Shinsei1
    then Shinsei1 is KyakkaZumi
  }
}
verify {
  instances Shinsei = 3
  values Kingaku = 0..3
}
