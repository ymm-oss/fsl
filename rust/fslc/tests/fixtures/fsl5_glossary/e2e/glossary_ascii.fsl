fsl 5
// e2e/glossary_ja.fsl with ASCII aliases (romanised Japanese): the
// resolution of aliases does not depend on the wider identifier rule.
// Lowers to exactly the kernel of fsl5/e2e/original.fsl.
requirements ExpenseRequirements {
  glossary {
    ExpenseRequirements = KeihiSeisanYoken
    Amount       = Kingaku
    AUTO_LIMIT   = JidoShoninJogen
    Claim        = Shinsei
    Claim.amount = ShinseiKingaku
    Draft        = Shitagaki
    Submitted    = TeishutsuZumi
    Approved     = ShoninZumi
    Rejected     = KyakkaZumi
    Paid         = ShiharaiZumi
    Employee     = Jugyoin
    System       = Shisutemu
    Manager      = Jocho
    Finance      = Keiri
    submit       = Teishutsu
    auto_approve = JidoShonin
    mgr_approve  = JochoShonin
    reject       = Kyakka
    pay          = Shiharai
    a            = NyuryokuKingaku
    paid_claims  = ShiharaiKensu
  }

  implements ExpenseToBe from "../../fsl5/e2e/1_business.fsl" {
    action submit(c, a) -> submit(c)
  }

  number Kingaku
  const JidoShoninJogen = 1

  process Shinsei with ShinseiKingaku: Kingaku = 0 {
    stages Shitagaki, TeishutsuZumi, ShoninZumi, KyakkaZumi, ShiharaiZumi
    initial Shitagaki

    transition Teishutsu     Shitagaki   -> TeishutsuZumi by Jugyoin
      with NyuryokuKingaku: Kingaku
      when NyuryokuKingaku > 0
      set ShinseiKingaku = NyuryokuKingaku
      covers REQ-1 "申請者は金額を入力して経費申請を提出する"

    transition JidoShonin TeishutsuZumi -> ShoninZumi by Shisutemu
      when ShinseiKingaku <= JidoShoninJogen
      covers REQ-2 "自動承認上限以下の申請はシステムが自動承認する"

    transition JochoShonin TeishutsuZumi -> ShoninZumi by Jocho
      when ShinseiKingaku >  JidoShoninJogen
      covers REQ-3 "自動承認上限を超える申請は上長が承認する"

    transition Kyakka     TeishutsuZumi -> KyakkaZumi by Jocho
      when ShinseiKingaku >  JidoShoninJogen
      covers REQ-3 "自動承認上限を超える申請は上長が却下できる"

    transition Shiharai     ShoninZumi -> ShiharaiZumi by Keiri
      covers REQ-4 "承認された申請だけが支払われる"
  }

  kpi ShiharaiKensu = count Shinsei in ShiharaiZumi

  acceptance AC-1 "承認の流れ: 少額の申請が自動承認され支払われる" {
    Teishutsu(0, 1) JidoShonin(0) Shiharai(0)
    expect Shinsei 0 in ShiharaiZumi
  }
  acceptance AC-2 "却下の流れ: 高額の申請が上長に却下される" {
    Teishutsu(1, 2) Kyakka(1)
    expect Shinsei 1 in KyakkaZumi
  }
}
verify {
  instances Shinsei = 3
  values Kingaku = 0..3
}
