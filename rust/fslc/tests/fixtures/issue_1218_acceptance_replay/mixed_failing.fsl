// #1218: under `--instances Case=1`, AC-1 references id 1 and is skipped,
// but AC-3 is in range and false: the scoped run must still fail on it.
requirements Mixed {
  entity Case
  enum St { Waiting, Accepted, Responded }
  state { cases: Map<Case, St> }
  init { forall c: Case { cases[c] = Waiting } }
  requirement REQ-1 "accept" {
    action accept(c: Case) { requires cases[c] == Waiting  cases[c] = Accepted }
  }
  requirement REQ-2 "respond" {
    action respond(c: Case) { requires cases[c] == Accepted  cases[c] = Responded }
  }
  acceptance AC-1 "second case" {
    accept(1)
    expect cases[1] == Accepted
  }
  acceptance AC-2 "first case" {
    accept(0)
    expect cases[0] == Accepted
  }
  acceptance AC-3 "first case responded too early" {
    accept(0)
    expect cases[0] == Responded
  }
}
verify { instances Case = 3 }
