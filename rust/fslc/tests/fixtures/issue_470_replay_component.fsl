ai_component ReplayComponent {
  model m1;
  prompt p1;
  input InV1;
  output OutV1;
  tool AuditTool {
    schema AuditToolV1;
    precondition case_open;
  }
  tool UnauthorizedTool {
    schema UnauthorizedToolV1;
  }
  authority {
    may_execute AuditTool;
  }
}
