// Intentional contract replacement under #1351 decision A: a requirement
// attached only to init has a real TSG anchor and must not be disconnected.
// Keep the historical fixture name; a separate graph control covers orphans.
spec AnalyzeOrphanRequirement {
  state { ready: Bool }

  @requirement("REQ-INIT-ONLY", "attached only to the initialization target")
  init { ready = false }

  action go() {
    ready = true
  }
}
