requirements ClaimReqAmount {
  implements ClaimFlow from "abs_business.fsl" { }

  number Amount

  process Claim {
    stages Draft, Submitted, Approved
    initial Draft
    transition submit  Draft     -> Submitted by Employee
    transition approve Submitted -> Approved  by Manager
  }
}
verify {
  instances Claim = 3
  values Amount = 0..3
}
