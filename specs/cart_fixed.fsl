// Shopping cart design spec (fixed version)
// Adds a stock guard to checkout. Since actions are atomic,
// the "check -> decrement" race cannot occur in this model.
spec ShoppingCart {
  const MAXU = 1
  const MAXI = 1

  type UserId = 0..MAXU
  type ItemId = 0..MAXI

  state {
    stock: Map<ItemId, Int>,
    cart:  Map<UserId, Option<ItemId>>
  }

  init {
    forall i: ItemId { stock[i] = 1 }
    forall u: UserId { cart[u] = none }
  }

  action add_to_cart(u: UserId, i: ItemId) {
    requires cart[u] == none
    cart[u] = some(i)
  }

  action remove_from_cart(u: UserId) {
    requires cart[u] != none
    cart[u] = none
  }

  action checkout(u: UserId) {
    requires cart[u] is some(i)
    requires stock[i] > 0         // Fix: checkout only allowed when stock is available
    stock[i] = stock[i] - 1
    cart[u] = none
  }

  invariant NoNegativeStock {
    forall i: ItemId { stock[i] >= 0 }
  }
}
