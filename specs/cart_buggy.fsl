// Shopping cart design spec (with a bug)
// Checked in a small scope: 2 users, 2 products, 1 unit of stock each
spec ShoppingCart {
  const MAXU = 1   // user id: 0..1
  const MAXI = 1   // product id: 0..1

  type UserId = 0..MAXU
  type ItemId = 0..MAXI

  state {
    stock: Map<ItemId, Int>,          // stock count per product
    cart:  Map<UserId, Option<ItemId>> // product in each user's cart
  }

  init {
    forall i: ItemId { stock[i] = 1 }
    forall u: UserId { cart[u] = none }
  }

  action add_to_cart(u: UserId, i: ItemId) {
    requires cart[u] == none
    cart[u] = some(i)
  }

  action remove_from_cart(u: UserId) {
    requires cart[u] != none
    cart[u] = none
  }

  action checkout(u: UserId) {
    requires cart[u] is some(i)
    // Bug: decrements stock without checking whether any is available
    stock[i] = stock[i] - 1
    cart[u] = none
  }

  invariant NoNegativeStock {
    forall i: ItemId { stock[i] >= 0 }
  }
}
