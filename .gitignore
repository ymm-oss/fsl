# Z3 solver trace file, written by native-z3 test/CLI runs into whichever
# directory the process's cwd happens to be (rust/, rust/fsl-solver-z3/,
# rust/fsl-verifier/, rust/fslc/, repo root, ...) — not a repo deliverable
.z3-trace

# VSCode extension build artifacts
node_modules/
editors/vscode/out/
*.vsix

# Claude Code local config (not part of the project)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/work/active.md
.claude/artifacts/
tasks/active.md
.codex-artifacts/

# Generated docs search index (bleve) — regenerable, not tracked
docs/index.bleve/

# fslc literate-Markdown materialization sibling (transient; leaked only on a crash)
*.literate.fsl

# Relational Design plugin local trace/session state — working scratch for the
# design process, not a repo deliverable (the decisions land in docs/DESIGN-*.md)
.relational-design/

# Nix build result symlinks
/result
/result-*
# Devbox generated artifacts
.devbox/
