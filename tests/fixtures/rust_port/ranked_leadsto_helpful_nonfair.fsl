spec HelpfulNonfair {
  type Case = 0..1
  type Level = 0..2
  state { level: Map<Case, Level> }
  init { forall c: Case { level[c] = 2 } }

  action step(c: Case) {
    requires level[c] > 0
    level[c] = level[c] - 1
  }

  action idle(c: Case) {
    level[c] = level[c]
  }

  invariant NonNeg { forall c: Case { level[c] >= 0 } }

  leadsTo Responds {
    forall c: Case { level[c] > 0 ~> level[c] == 0 }
    helpful step(c)
    decreases level[c]
  }
}
